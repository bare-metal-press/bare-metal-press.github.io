---
import Base from '../layouts/Base.astro';

const description = 'Bare Metal Press.';
---

<Base title={null} description={description}>
  <section class="wrap hero">
    <h1>Bare&nbsp;Metal<br />Press</h1>
  </section>

  <style>
    .hero {
      display: grid;
      align-content: center;
      min-height: 78svh;
      padding-block: clamp(3rem, 10vh, 6rem);
    }

    h1 {
      font-size: clamp(3rem, 13vw, 8rem);
      letter-spacing: -0.045em;
      text-transform: uppercase;
    }
  </style>
</Base>
