---
import Base from '../layouts/Base.astro';

const description =
  'Bare Metal Press is an independent publisher of technical books.';
---

<Base title={null} description={description}>
  <section class="wrap hero">
    <p class="eyebrow">Independent publisher</p>
    <h1>Bare&nbsp;Metal<br />Press</h1>
    <p class="lede">Technical books, carefully edited, published direct.</p>
  </section>

  <hr class="rule" />

  <section class="wrap catalog">
    <h2 class="eyebrow">Catalog</h2>
    <p class="pending">First title in preparation.</p>
  </section>

  <style>
    .hero {
      padding-block: clamp(3rem, 12vh, 7rem) clamp(2.5rem, 8vh, 5rem);
    }

    h1 {
      font-size: clamp(3rem, 13vw, 8rem);
      letter-spacing: -0.045em;
      text-transform: uppercase;
      margin-top: 1.5rem;
    }

    .lede {
      max-width: var(--measure);
      font-size: 1.25rem;
      margin-top: 2rem;
      color: var(--ink-soft);
    }

    .catalog {
      padding-block: 3rem;
    }

    .pending {
      color: var(--muted);
      margin-top: 1rem;
    }
  </style>
</Base>
