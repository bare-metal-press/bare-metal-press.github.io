---
import Base from '../layouts/Base.astro';

const description = 'Bare Metal Press.';
---

<Base title={null} description={description}>
  <section class="wrap hero">
    <h1>Bare&nbsp;Metal<br />Press</h1>
  </section>

  <style>
    .hero {
      display: grid;
      align-content: center;
      min-height: 78svh;
      padding-block: clamp(3rem, 10vh, 6rem);
    }

    h1 {
      /* Anton is condensed, so it takes a larger size than a grotesque
         to fill the same measure. */
      font-size: clamp(3.5rem, 16vw, 10rem);
      text-transform: uppercase;
    }
  </style>
</Base>
