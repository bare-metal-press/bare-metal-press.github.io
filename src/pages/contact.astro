---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="How to reach Bare Metal Press.">
  <section class="wrap page">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="text">For questions about the books, distribution or press:</p>
    <p class="email">
      <a href="mailto:baremetalpress@pm.me">baremetalpress@pm.me</a>
    </p>
  </section>

  <style>
    .page {
      padding-block: clamp(2.5rem, 8vh, 5rem);
    }

    h1 {
      font-size: clamp(2.25rem, 7vw, 4rem);
      text-transform: uppercase;
      margin-top: 1rem;
    }

    .text {
      margin-top: 2rem;
      max-width: var(--measure);
    }

    .email {
      font-family: var(--font-mono);
      font-size: 1.125rem;
      margin-top: 0.5rem;
    }
  </style>
</Base>
