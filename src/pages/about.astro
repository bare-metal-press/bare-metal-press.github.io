---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
---

<Base title="About" description="Who works at Bare Metal Press and how.">
  <Hero title="About" em={2.319} compact />

  <section class="wrap intro">
    <p>
      Bare Metal Press is a working group of researchers, analysts, writers,
      editors and technical reviewers.
    </p>
    <p>
      Each title is assembled by whoever knows the subject. The rest of the
      group reads the draft from outside that discipline; if the explanation
      only works for someone who already shares the author's assumptions, it
      goes back.
    </p>
    <p>We produce training material in the fields the group covers.</p>
  </section>

  <style>
    .intro {
      padding-bottom: 2rem;
    }

    .intro p {
      max-width: var(--measure);
      margin: 0 0 1.25rem;
    }
  </style>
</Base>
