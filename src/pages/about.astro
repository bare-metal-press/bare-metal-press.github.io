---
import Base from '../layouts/Base.astro';
---

<Base title="About" description="What Bare Metal Press is and how it publishes.">
  <section class="wrap page">
    <p class="eyebrow">About</p>
    <h1>Bare Metal Press</h1>
    <p class="pending">Text to be written.</p>
  </section>

  <style>
    .page {
      padding-block: clamp(2.5rem, 8vh, 5rem);
    }

    h1 {
      font-size: clamp(2.25rem, 7vw, 4rem);
      text-transform: uppercase;
      margin-top: 1rem;
    }

    .pending {
      color: var(--muted);
      margin-top: 2rem;
      max-width: var(--measure);
    }
  </style>
</Base>
