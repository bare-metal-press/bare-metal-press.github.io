---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
---

<Base title="Thank you" description="Your message has been sent.">
  <Hero title="Thank you" em={3.991} compact />

  <section class="wrap">
    <p>Received. We only reply when there is a fit.</p>
    <p><a href="/">Back to the home page</a></p>
  </section>

  <style>
    section {
      padding-bottom: 2rem;
    }

    p {
      max-width: var(--measure);
      margin: 0 0 1.25rem;
    }
  </style>
</Base>
