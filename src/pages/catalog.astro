---
import Base from '../layouts/Base.astro';
---

<Base title="Catalog" description="Books published by Bare Metal Press.">
  <section class="wrap page">
    <p class="eyebrow">Catalog</p>
    <h1>Titles</h1>
    <p class="pending">First title in preparation.</p>
  </section>

  <style>
    .page {
      padding-block: clamp(2.5rem, 8vh, 5rem);
    }

    h1 {
      font-size: clamp(2.25rem, 7vw, 4rem);
      text-transform: uppercase;
      margin-top: 1rem;
    }

    .pending {
      color: var(--muted);
      margin-top: 2rem;
      max-width: var(--measure);
    }
  </style>
</Base>
